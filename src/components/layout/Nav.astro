---
/**
 * El menú, con su animación de entrada.
 *
 * Es un <details>: se abre y se cierra sin JavaScript, se enfoca con el teclado y
 * lo anuncia un lector de pantalla, todo de serie. Las cuatro líneas de script que
 * hay debajo solo añaden cerrar con Escape y al pulsar fuera; sin ellas el menú
 * sigue funcionando.
 */
import logo from '../../assets/brand/logotipo-oro.svg';
import { copy, ruta, otroIdioma, type Ruta } from '../../lib/i18n.ts';
import type { Locale } from '../../lib/menu/types.ts';

interface Props {
  locale: Locale;
  here: Ruta;
}

const { locale, here } = Astro.props;
const t = copy(locale);
const otro = otroIdioma(locale);

const entradas = [
  { texto: t.nav.inicio, href: ruta('inicio', locale) },
  { texto: t.nav.carta, href: ruta('carta', locale) },
];
---

<header class="nav">
  <div class="wrap nav__fila">
    <a class="nav__marca" href={ruta('inicio', locale)}>
      <img src={logo.src} alt={t.sitio.nombre} width="180" height="78" />
    </a>

    <details class="nav__caja" name="menu-principal">
      <summary class="nav__boton">
        <span class="nav__boton-texto" data-abrir>{t.nav.abrir}</span>
        <span class="nav__boton-texto" data-cerrar>{t.nav.cerrar}</span>
      </summary>

      <div class="nav__panel">
        <ul class="nav__acciones" role="list">
          <li class="entra" style="--indice:0">
            <a href="https://cuquita.hrpos.heartland.us/" rel="noopener">{t.nav.pedir}</a>
          </li>
          <li class="entra" style="--indice:1">
            <a href="tel:+16108685252">{t.nav.llamar} · 610-868-5252</a>
          </li>
        </ul>

        <ul class="nav__entradas" role="list">
          {
            entradas.map((entrada, index) => (
              <li class="entra" style={`--indice:${index + 2}`}>
                <a href={entrada.href}>{entrada.texto}</a>
              </li>
            ))
          }
          <li class="entra" style={`--indice:${entradas.length + 2}`}>
            <a href={ruta(here, otro)} lang={otro} hreflang={otro}>{t.nav.otroIdioma}</a>
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>

<script>
  // Progresivo: el <details> ya abre y cierra solo. Esto solo añade Escape y
  // pulsar fuera, que es lo que espera cualquiera que use un menú así.
  const caja = document.querySelector<HTMLDetailsElement>('.nav__caja');

  if (caja) {
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') caja.open = false;
    });

    document.addEventListener('click', (evento) => {
      if (caja.open && !caja.contains(evento.target as Node)) caja.open = false;
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    border-block-end: 1px solid var(--color-rule);
    background: var(--color-bg-alt);
  }

  .nav__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
  }

  .nav__marca img {
    inline-size: clamp(7rem, 20vw, 10rem);
    block-size: auto;
  }

  .nav__boton {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: var(--space-s);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .nav__boton::-webkit-details-marker {
    display: none;
  }

  [data-cerrar],
  .nav__caja[open] [data-abrir] {
    display: none;
  }

  .nav__caja[open] [data-cerrar] {
    display: inline;
  }

  .nav__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    padding: var(--space-m) var(--gutter) var(--space-l);
    border-block-end: 1px solid var(--color-rule);
    background: var(--color-bg-alt);
  }

  .nav__acciones,
  .nav__entradas {
    margin: 0;
    padding: 0;
  }

  .nav__acciones {
    padding-block-end: var(--space-s);
    border-block-end: 1px solid var(--color-rule);
  }

  .nav__entradas {
    padding-block-start: var(--space-s);
  }

  .nav__panel a {
    display: block;
    padding-block: var(--space-2xs);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav__acciones a {
    color: var(--color-accent);
    font-size: var(--step-1);
  }

  .nav__panel a:hover {
    color: var(--color-accent-text);
  }
</style>
