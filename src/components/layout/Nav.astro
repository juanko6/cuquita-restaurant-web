---
/**
 * El menú.
 *
 * Sigue siendo un <details>: abre, cierra, se recorre con el teclado y lo anuncia
 * un lector de pantalla sin una línea de JavaScript. Lo único que añade el script
 * es cerrar con Escape y al pulsar fuera.
 *
 * El panel es **crema sobre vino**, no otro tono de vino: abierto tiene que verse
 * que es otra superficie y no más de lo mismo. Las entradas convergen hacia el
 * centro —las acciones desde la izquierda, la navegación desde la derecha— y esa
 * transición se ve igual al abrir que al cerrar, gracias a `::details-content`.
 */
import logo from '../../assets/brand/logotipo-oro.svg';
import { copy, ruta, otroIdioma, type Ruta } from '../../lib/i18n.ts';
import type { Locale } from '../../lib/menu/types.ts';

interface Props {
  locale: Locale;
  here: Ruta;
}

const { locale, here } = Astro.props;
const t = copy(locale);
const otro = otroIdioma(locale);

const acciones = [
  { texto: t.nav.pedir, href: 'https://cuquita.hrpos.heartland.us/', externo: true },
  { texto: `${t.nav.llamar} · 610-868-5252`, href: 'tel:+16108685252', externo: false },
];

const entradas = [
  { texto: t.nav.inicio, href: ruta('inicio', locale) },
  { texto: t.nav.carta, href: ruta('carta', locale) },
  { texto: t.nav.experiencia, href: ruta('experiencia', locale) },
  { texto: t.nav.visita, href: ruta('visita', locale) },
];
---

<header class="nav">
  <div class="wrap nav__fila">
    <a class="nav__marca" href={ruta('inicio', locale)}>
      <img src={logo.src} alt={t.sitio.nombre} width="392" height="198" />
    </a>

    <div class="nav__derecha">
      <a class="nav__telefono" href="tel:+16108685252">610-868-5252</a>

      <details class="nav__caja">
        <summary class="nav__boton">
          <span class="solo-lectores" data-abrir>{t.nav.abrir}</span>
          <span class="solo-lectores" data-cerrar>{t.nav.cerrar}</span>
          <span class="nav__hamburguesa" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </summary>

        <div class="nav__panel">
          <div class="wrap">
            <ul class="nav__acciones" role="list">
              {
                acciones.map((accion, index) => (
                  <li style={`--indice:${index}`}>
                    <a href={accion.href} rel={accion.externo ? 'noopener' : undefined}>
                      {accion.texto}
                    </a>
                  </li>
                ))
              }
            </ul>

            <ul class="nav__entradas" role="list">
              {
                entradas.map((entrada, index) => (
                  <li style={`--indice:${index}`}>
                    <a href={entrada.href}>{entrada.texto}</a>
                  </li>
                ))
              }
              <li style={`--indice:${entradas.length}`}>
                <a href={ruta(here, otro)} lang={otro} hreflang={otro}>{t.nav.otroIdioma}</a>
              </li>
            </ul>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // El <details> ya abre y cierra solo. Esto añade Escape y pulsar fuera, que es
  // lo que espera cualquiera que use un menú así.
  const caja = document.querySelector<HTMLDetailsElement>('.nav__caja');

  if (caja) {
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') caja.open = false;
    });

    document.addEventListener('click', (evento) => {
      if (caja.open && !caja.contains(evento.target as Node)) caja.open = false;
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    border-block-end: 1px solid var(--color-rule);
    background: var(--color-bg-alt);
  }

  .nav__fila {
    display: flex;
    min-block-size: var(--alto-nav);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
  }

  .nav__marca img {
    display: block;
    inline-size: auto;
    block-size: clamp(1.9rem, 4.5vw, 2.6rem);
  }

  .nav__derecha {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  /* El teléfono se queda fuera del menú: en un restaurante llamar no puede costar
     dos toques, y la mitad del tráfico llega desde un móvil. */
  .nav__telefono {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .nav__telefono:hover {
    text-decoration: underline;
  }

  /* --- El botón: cuadrado, con la hamburguesa --- */
  .nav__boton {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .nav__boton::-webkit-details-marker {
    display: none;
  }

  .nav__boton:hover,
  .nav__caja[open] .nav__boton {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .nav__hamburguesa {
    display: grid;
    gap: 4px;
    inline-size: 1.125rem;
  }

  .nav__hamburguesa span {
    display: block;
    block-size: 2px;
    background: currentcolor;
    transition:
      translate var(--dur-fast) var(--ease-out),
      rotate var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  /* Abierto, las tres barras se cruzan. */
  .nav__caja[open] .nav__hamburguesa span:first-child {
    translate: 0 6px;
    rotate: 45deg;
  }

  .nav__caja[open] .nav__hamburguesa span:nth-child(2) {
    opacity: 0;
  }

  .nav__caja[open] .nav__hamburguesa span:last-child {
    translate: 0 -6px;
    rotate: -45deg;
  }

  [data-cerrar],
  .nav__caja[open] [data-abrir] {
    display: none;
  }

  .nav__caja[open] [data-cerrar] {
    display: inline;
  }

  /* --- El panel: crema, para que se note que es otra superficie --- */
  .nav__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    padding-block: var(--space-l) var(--space-xl);
    border-block-end: 3px solid var(--c-gold);
    background: var(--c-cream);
    color: var(--c-wine);
  }

  .nav__acciones,
  .nav__entradas {
    margin: 0;
    padding: 0;
  }

  .nav__acciones {
    padding-block-end: var(--space-s);
    border-block-end: 1px solid color-mix(in srgb, var(--c-wine) 25%, transparent);
  }

  .nav__entradas {
    padding-block-start: var(--space-s);
  }

  .nav__panel a {
    display: block;
    padding-block: var(--space-2xs);
    color: var(--c-wine);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav__acciones a {
    font-size: var(--step-1);
  }

  .nav__panel a:hover {
    color: color-mix(in srgb, var(--c-wine) 70%, var(--c-gold));
    text-decoration: underline;
  }

  /* --- La transición, igual al abrir que al cerrar ---
     `::details-content` es lo que permite animar el cierre: sin él el navegador
     quita el contenido de golpe y solo se vería la entrada. Donde no esté
     soportado, el menú abre y cierra sin animación y no se rompe nada. */
  @media (prefers-reduced-motion: no-preference) {
    .nav__caja::details-content {
      opacity: 0;
      transition:
        opacity var(--dur-base) var(--ease-out),
        content-visibility var(--dur-base) allow-discrete;
    }

    .nav__caja[open]::details-content {
      opacity: 1;
    }

    /* Las acciones llegan desde la izquierda y la navegación desde la derecha:
       las dos hacia el centro, con 40 ms entre una entrada y la siguiente. */
    .nav__acciones li,
    .nav__entradas li {
      transition:
        translate var(--dur-base) var(--ease-out),
        opacity var(--dur-base) var(--ease-out);
      transition-delay: calc(var(--indice, 0) * var(--stagger-item));
    }

    .nav__caja:not([open]) .nav__acciones li {
      translate: -1.5rem 0;
      opacity: 0;
    }

    .nav__caja:not([open]) .nav__entradas li {
      translate: 1.5rem 0;
      opacity: 0;
    }

    /* Y el botón baja a su sitio al cargar la página. */
    .nav__boton {
      animation: baja-el-boton var(--dur-base) var(--ease-out) var(--intro-boton) both;
    }

    @keyframes baja-el-boton {
      from {
        translate: 0 -1.5rem;
        opacity: 0;
      }
    }
  }
</style>
