---
/**
 * La portada. Las dos rutas —/ y /en/— son la misma página con el idioma cambiado.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../layout/Nav.astro';
import Footer from '../layout/Footer.astro';
import Button from '../ui/Button.astro';
import Hero from './Hero.astro';
import Today from './Today.astro';
import Carousel from '../ui/Carousel.astro';
import Frame from '../ui/Frame.astro';
import Lede from '../ui/Lede.astro';
import Marquee from '../ui/Marquee.astro';
import Section from '../ui/Section.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import DishCard from '../menu/DishCard.astro';
import Reviews from './Reviews.astro';
import Visit from './Visit.astro';
import Week from './Week.astro';
import { copy, ruta } from '../../lib/i18n.ts';
import { getMenu } from '../../lib/menu/index.ts';
import { featuredDishes } from '../../lib/menu/featured.ts';
import mesaServida from '../../assets/local/mesa-servida.webp';
import clientes from '../../assets/local/clientes.webp';
import type { Locale } from '../../lib/menu/types.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy(locale);
const menu = getMenu(locale);
const destacados = featuredDishes(menu);
const INSTAGRAM = 'https://www.instagram.com/cuquitarestaurant/';
---

<Base
  title={`${t.sitio.nombre} — ${t.inicio.tituloPagina}`}
  description={t.sitio.descripcionInicio}
  lang={locale}
  alternate="inicio"
  watermark
>
  <Nav slot="header" locale={locale} here="inicio" variante="sobre-video" />

  <Hero locale={locale} />

  <Section tone="none" labelledby="hoy">
    <Today locale={locale} specials={menu.specials} />
  </Section>

  <Marquee items={t.inicio.bandaPiezas} />

  <Section tone="none">
    <SplitHeading lines={t.inicio.conceptoLineas} accent={1} />
    <Lede text={t.inicio.conceptoTexto} />
    <Frame src={mesaServida} alt={t.inicio.conceptoFoto} zoom={1.35} />
  </Section>

  <Section tone="none">
    <SplitHeading lines={t.inicio.destacadosLineas} />
    <Lede text={t.inicio.destacadosTexto} />
    <div class="destacados">
      <Carousel label={t.carta.titulo}>
        {destacados.map((dish) => <DishCard dish={dish} />)}
      </Carousel>
    </div>
    <p class="acciones">
      <Button variant="outline" href={ruta('carta', locale)}>{t.nav.carta}</Button>
    </p>
  </Section>

  <Section tone="none">
    <SplitHeading lines={t.inicio.semanaLineas} accent={1} />
    <Lede text={t.inicio.semanaTexto} />
    <Week locale={locale} specials={menu.specials} />
  </Section>

  <Section tone="none">
    <SplitHeading lines={t.inicio.experienciaLineas} />
    <Lede text={t.inicio.experienciaTexto} />
    <Frame src={clientes} alt={t.inicio.experienciaFoto} />
  </Section>

  <Section tone="none">
    <SplitHeading lines={t.inicio.resenasLineas} accent={0} />
    <Lede text={t.inicio.resenasTexto} />
    <Reviews locale={locale} />
  </Section>

  <Section tone="none">
    <SplitHeading lines={t.inicio.redesLineas} accent={1} />
    <Lede text={t.inicio.redesTexto} />
    <p class="acciones">
      <Button variant="solid" href={INSTAGRAM} rel="noopener">@cuquitarestaurant</Button>
    </p>
  </Section>

  <Section tone="none">
    <SplitHeading lines={t.inicio.visitaLineas} accent={1} />
    <Visit locale={locale} />
  </Section>

  <Footer slot="footer" locale={locale} />
</Base>

<style>
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }

  .destacados {
    margin-block-start: var(--space-l);
  }
</style>
