---
/**
 * La semana entera: qué plato toca cada día.
 *
 * Sale de los `recurrence_days` de MenuUnfolded, así que si el restaurante cambia
 * un especial esto cambia solo. El martes se cuenta con gracia, no como un hueco.
 */
import { copy } from '../../lib/i18n.ts';
import { money } from '../../lib/format.ts';
import { daySpecial, everydaySpecials } from '../../lib/specials.ts';
import type { Locale, Special } from '../../lib/menu/types.ts';

interface Props {
  locale: Locale;
  specials: readonly Special[];
}

const { locale, specials } = Astro.props;
const t = copy(locale);
const MARTES = 1;

const siempre = everydaySpecials(specials);

const dias = t.inicio.horario.map(([nombre], indice) => {
  const especial = daySpecial(specials, indice);
  return { nombre, indice, especial, cerrado: indice === MARTES };
});
---

<ul class="semana" role="list">
  {
    dias.map(({ nombre, especial, cerrado }) => (
      <li class:list={['semana__dia', { 'semana__dia--cerrado': cerrado }]}>
        <p class="semana__nombre">{nombre}</p>
        {cerrado ? (
          <p class="semana__plato semana__plato--apagado">{t.inicio.semanaCerrado}</p>
        ) : especial ? (
          <>
            <p class="semana__plato">{especial.title}</p>
            <span class="semana__precio">{money(especial.price)}</span>
          </>
        ) : (
          <p class="semana__plato semana__plato--apagado">{t.inicio.semanaSinEspecial}</p>
        )}
      </li>
    ))
  }
</ul>

{
  siempre.length > 0 && (
    <p class="semana__siempre">
      {t.inicio.semanaSiempre} {siempre.map((special) => special.title).join(' · ')}
    </p>
  )
}

<style>
  .semana {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1px;
    margin: var(--space-l) 0 0;
    padding: 0;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
  }

  .semana__dia {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-block-size: 7rem;
    padding: var(--space-s);
    background: var(--color-bg);
  }

  .semana__dia--cerrado {
    background: var(--color-bg-alt);
  }

  .semana__nombre {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .semana__plato {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .semana__plato--apagado {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .semana__siempre {
    margin-block-start: var(--space-s);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .semana__precio {
    margin-block-start: auto;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
</style>
