---
/**
 * Una foto por la ventana del vídeo de la portada.
 *
 * Comparte marco con el hero —los dos leen `--marco-ancho` y `--marco-alto`—, así
 * que todas las piezas de imagen del inicio riman en medida y en sitio. Con las dos
 * medidas puestas, la relación de aspecto de la fuente deja de mandar: manda el
 * marco, y `cover` recorta lo que sobre.
 *
 * `zoom` acerca por encima de ese recorte. Cuánto se puede subir lo dice la fuente:
 * pedirle a una foto pequeña que llene el marco y encima se acerque es pedirle
 * píxeles que no tiene.
 */
import Picture from './Picture.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 1 es el encuadre que ya da `cover`. Por encima, se acerca al centro. */
  zoom?: number;
  class?: string;
}

const { src, alt, zoom = 1, class: extra } = Astro.props;
---

<figure class:list={['marco', extra]} style={`--zoom:${zoom}`}>
  <Picture
    class="marco__foto"
    src={src}
    alt={alt}
    widths={[640, 960, 1400]}
    sizes="(max-width: 48rem) 92vw, min(78vw, 58rem)"
  />
</figure>

<style>
  .marco {
    margin: var(--space-2xl) 0 0;
  }

  /* Picture pone su propia clase en la raíz, fuera del ámbito de este archivo: por
     eso se alcanza como descendiente global y no a secas. */
  .marco :global(.marco__foto) {
    inline-size: var(--marco-ancho);
    block-size: var(--marco-alto);
  }

  .marco :global(.marco__foto img) {
    object-position: center;
    scale: var(--zoom);
  }
</style>
