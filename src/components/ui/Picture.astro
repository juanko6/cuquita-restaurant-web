---
/**
 * Envoltorio de `astro:assets` con relación de aspecto fija.
 *
 * `alt` es obligatorio a propósito: sin texto alternativo esto no compila. Y el
 * hueco lo reserva la propia caja, así que la página no da saltos al cargar.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  ratio = '4 / 3',
  sizes = '(max-width: 48rem) 60vw, 17rem',
  widths = [280, 420, 640],
  loading = 'lazy',
  class: extra,
} = Astro.props;
---

<div class:list={['foto', extra]} style={`--ratio:${ratio}`}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
</div>

<style>
  .foto {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    background: var(--color-bg-alt);
  }

  .foto :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>
